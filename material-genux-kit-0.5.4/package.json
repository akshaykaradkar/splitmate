{
  "name": "material-genux-kit",
  "private": true,
  "version": "0.5.4",
  "type": "module",
  "scripts": {
    "start": "npm run dev",
    "dev": "vite",
    "build": "tsc && vite build",
    "build:cdn": "vite build -c vite-cdn.config.ts",
    "preview": "vite preview",
    "pre:zip": "npm run build",
    "zip": "file=$(npm pack) && tar -xzf $file && cd package && zip -r \"../${file%.tgz}.zip\" . && cd .. && rm -rf package $file",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:run": "vitest run",
    "test:smoke": "SMOKE_TEST=1 vitest run src/test/smoke/ --reporter=verbose",
    "test:watch": "vitest --watch",
    "zipline": "node .zipline/main.cjs",
    "deploy": "npm run build && npm run zipline -- upload --source dist",
    "deploy:storybook": "npm run storybook:build && npm run zipline -- upload --config .zipline/zipline-config-storybook.json"
  },
  "dependencies": {
    "@lit/react": "^1.0.8",
    "@material/material-color-utilities": "^0.4.0",
    "@material/web": "2.4.2-nightly.95013d6.0",
    "@tailwindcss/vite": "^4.2.0",
    "lit": "^3.3.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.3",
    "@storybook/addon-a11y": "^10.2.12",
    "@storybook/addon-docs": "^10.2.12",
    "@storybook/react-vite": "^10.2.12",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.13",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "element-internals-polyfill": "^3.0.2",
    "eslint": "^9.39.3",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.3.0",
    "jsdom": "^28.1.0",
    "shadow-dom-testing-library": "^1.13.1",
    "storybook": "^10.2.12",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
